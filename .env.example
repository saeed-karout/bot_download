# ═══ إلزامي ═══
BOT_TOKEN=ضع_توكن_البوت_من_BotFather
ADMIN_ID=معرفك_الرقمي

# ═══ اختياري ═══
ADMIN_IDS=                       # أدمن إضافيون مفصولون بفاصلة
ADMIN_CONTACT=@username

# ═══ الدفع ═══
SHAMCASH_NUMBER=+9639xxxxxxxx
SHAMCASH_QR_PATH=qr.jpg

# ═══ رفع ملفات أكبر من 50 ميغا ═══
# Bot API الرسمي يحد الرفع بـ 50MB.
# شغّل Local Bot API Server لرفع حتى 2000MB ثم فعّل السطر:
# LOCAL_BOT_API=http://127.0.0.1:8081/bot

# ═══ ضبط الأداء ═══
MAX_CONCURRENT_DOWNLOADS=4
MAX_PER_USER_CONCURRENT=1
MAX_DOWNLOAD_SECONDS=1200
DEFAULT_SPEED_MBPS=25
# PROXY=http://user:pass@host:port
